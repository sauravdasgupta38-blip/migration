+# ------------------------------------------------------------ LLM call tracing
+# Print-only diagnostics for every LLM round-trip. Set DATAMAP_LLM_TRACE=0 to
+# silence. Nothing here changes control flow: a failure is printed and then
+# re-raised, so each tier's existing fallback runs exactly as before.
+_LLM_TRACE_ON = os.getenv("DATAMAP_LLM_TRACE", "1") != "0"
+_LLM_STATS: dict = {}
+_LLM_STAT_KEYS = ("calls", "json_ok", "call_failed", "bad_json", "unknown_error",
+                  "reply_issues", "offline")
+_LLM_NET_MODULES = ("openai", "httpx", "httpcore", "requests", "urllib3", "azure", "aiohttp")
+_LLM_NET_NAMES = ("timeout", "connection", "ratelimit", "authentication", "permissiondenied",
+                  "apierror", "apistatus", "badrequest", "notfound", "internalserver",
+                  "serviceunavailable", "gateway")
+
+
+def _llm_log(stage: str, tag: str, msg: str) -> None:
+    if _LLM_TRACE_ON:
+        print(f"[LLM][{stage}][{tag}] {msg}", flush=True)
+
+
+def _llm_bump(stage: str, key: str, n: int = 1) -> dict:
+    s = _LLM_STATS.setdefault(stage, dict.fromkeys(_LLM_STAT_KEYS, 0))
+    s[key] += n
+    return s
+
+
+def _llm_drop(stage: str, msg: str) -> None:
+    """A proposal the model returned that downstream code had to discard."""
+    _llm_bump(stage, "reply_issues")
+    _llm_log(stage, "DROP", msg)
+
+
+def _llm_preview(obj, limit: int = 300) -> str:
+    try:
+        text = obj if isinstance(obj, str) else json.dumps(obj, default=str)
+    except Exception:                                   # noqa: BLE001
+        text = repr(obj)
+    return text if len(text) <= limit else f"{text[:limit]}... (+{len(text) - limit} chars)"
+
+
+def _llm_short(items: list, limit: int = 8) -> str:
+    shown = ", ".join(str(i) for i in items[:limit])
+    return shown + (f" (+{len(items) - limit} more)" if len(items) > limit else "")
+
+
+def _llm_classify(exc: Exception) -> tuple[str, str]:
+    """Best-effort split of a failure into 'the call broke' vs 'the reply was bad'."""
+    name = type(exc).__name__.lower()
+    module = (type(exc).__module__ or "").lower()
+    text = str(exc).lower()
+    if isinstance(exc, json.JSONDecodeError):
+        return "bad_json", "reply is not valid JSON"
+    if module.startswith(_LLM_NET_MODULES) or any(k in name for k in _LLM_NET_NAMES):
+        return "call_failed", "the request itself failed (network/auth/quota/gateway/bad request)"
+    if any(k in text for k in ("finish_reason", "max_tokens", "truncat")):
+        return "bad_json", "reply was cut off before the JSON was complete"
+    if isinstance(exc, (ValueError, TypeError, KeyError, AttributeError)):
+        return "bad_json", "reply could not be turned into the expected JSON object"
+    return "unknown_error", "unclassified failure (traceback below)"
+
+
+def _llm_client(stage: str, config):
+    """config.llm_client() with the outcome printed. Re-raises on failure."""
+    try:
+        client, model = config.llm_client()
+    except Exception as exc:                            # noqa: BLE001
+        _llm_bump(stage, "calls")
+        _llm_bump(stage, "call_failed")
+        _llm_log(stage, "FAIL", f"could not create the LLM client — {type(exc).__name__}: {exc}")
+        raise
+    if client is None:
+        _llm_bump(stage, "offline")
+        _llm_log(stage, "SKIP", "no LLM configured (offline) — this stage makes no call")
+    return client, model
+
+
+def _llm_call(stage: str, client, model, messages: list, **kwargs) -> dict:
+    """_llm_json with every outcome printed. Exceptions are re-raised and the
+    reply is returned untouched, so each caller fails exactly as it did before."""
+    n = _llm_bump(stage, "calls")["calls"]
+    chars = sum(len(str(m.get("content") or "")) for m in messages)
+    _llm_log(stage, "CALL", f"#{n} model={model} prompt_chars={chars:,} "
+                            f"max_tokens={kwargs.get('max_tokens', 'default')}")
+    t0 = time.perf_counter()
+    try:
+        out = _llm_json(client, model, messages, **kwargs)
+    except Exception as exc:                            # noqa: BLE001
+        kind, why = _llm_classify(exc)
+        _llm_bump(stage, kind)
+        _llm_log(stage, "FAIL", f"#{n} after {time.perf_counter() - t0:.1f}s — {kind.upper()}: "
+                                f"{why} | {type(exc).__name__}: {_llm_preview(str(exc), 500)}")
+        if kind == "unknown_error" and _LLM_TRACE_ON:
+            print(traceback.format_exc(limit=5), flush=True)
+        raise
+    secs = time.perf_counter() - t0
+    if not isinstance(out, dict):
+        _llm_bump(stage, "bad_json")
+        _llm_log(stage, "FAIL", f"#{n} after {secs:.1f}s — BAD_JSON: expected a JSON object, "
+                                f"got {type(out).__name__}: {_llm_preview(out)}")
+        return out                              # caller's .get() fails as before
+    _llm_bump(stage, "json_ok")
+    _llm_log(stage, "OK", f"#{n} in {secs:.1f}s — JSON object, keys={sorted(out)}")
+    return out
+
+
+def _llm_check_keyed(stage: str, out: dict, section: str, expected: list, *,
+                     required=(), bools=(), dicts=(), source_field=None,
+                     valid_sources=None) -> None:
+    """Audit a {section: {<target>: {...}}} reply against what downstream reads.
+
+    Print-only: never raises, never modifies the reply.
+    """
+    try:
+        raw = out.get(section)
+        if not isinstance(raw, dict):
+            _llm_bump(stage, "reply_issues")
+            what = "missing" if raw is None else f"a {type(raw).__name__}, not an object"
+            _llm_log(stage, "WARN", f"key '{section}' is {what} (top-level keys: {sorted(out)}) — "
+                                    f"nothing in this reply is usable"
+                                    + ("" if raw is None else "; downstream .get() on it will raise"))
+            return
+        problems: dict = {}
+        for name in expected:
+            if name not in raw:
+                problems.setdefault("no entry returned", []).append(name)
+                continue
+            entry = raw[name]
+            if not isinstance(entry, dict):
+                problems.setdefault("entry is not an object", []).append(
+                    f"{name}={_llm_preview(entry, 60)}")
+                continue
+            for f in required:
+                if f not in entry:
+                    problems.setdefault(f"missing field '{f}'", []).append(name)
+            for f in bools:
+                if f in entry and not isinstance(entry[f], bool):
+                    problems.setdefault(f"'{f}' is not true/false", []).append(f"{name}={entry[f]!r}")
+            for f in dicts:
+                if f in entry and not isinstance(entry[f], dict):
+                    problems.setdefault(f"'{f}' is not an object", []).append(name)
+            if source_field and entry.get(source_field) is not None:
+                sid = entry[source_field]
+                if not isinstance(sid, str):
+                    problems.setdefault(f"'{source_field}' is not a string", []).append(f"{name}={sid!r}")
+                elif valid_sources is not None and sid not in valid_sources:
+                    problems.setdefault(f"'{source_field}' is not a known source column", []).append(
+                        f"{name}->{sid!r}")
+        wanted = set(expected)
+        extra = [k for k in raw if k not in wanted]
+        if extra:
+            problems["unexpected target name (renamed or misspelt?)"] = extra
+        usable = sum(1 for name in expected if isinstance(raw.get(name), dict))
+        issues = sum(len(v) for v in problems.values())
+        _llm_log(stage, "CHECK", f"{usable}/{len(expected)} target(s) answered in usable form, "
+                                 f"{issues} issue(s)")
+        for label, items in problems.items():
+            _llm_log(stage, "WARN", f"{label}: {_llm_short(items)}")
+        if issues:
+            _llm_bump(stage, "reply_issues", issues)
+    except Exception as exc:                            # noqa: BLE001
+        _llm_log(stage, "WARN", f"reply check itself failed: {type(exc).__name__}: {exc}")
+
+
+def _llm_check_synth(out: dict, asked: list) -> None:
+    """Audit {"results": [{target, sql, reason}]} for _llm_synthesise. Print-only."""
+    stage = "synthesise"
+    try:
+        raw = out.get("results")
+        if not isinstance(raw, list):
+            _llm_bump(stage, "reply_issues")
+            what = "missing" if raw is None else f"a {type(raw).__name__}, not a list"
+            _llm_log(stage, "WARN", f"key 'results' is {what} (top-level keys: {sorted(out)}) — "
+                                    f"nothing in this reply is usable")
+            return
+        problems: dict = {}
+        seen, declined = [], []
+        for i, r in enumerate(raw):
+            if not isinstance(r, dict):
+                problems.setdefault("result is not an object (whole stage will be skipped)",
+                                    []).append(f"#{i}={_llm_preview(r, 60)}")
+                continue
+            t = r.get("target")
+            if not isinstance(t, str) or t not in asked:
+                problems.setdefault("unknown or missing 'target'", []).append(f"#{i}={t!r}")
+                continue
+            if t in seen:
+                problems.setdefault("duplicate target (last one wins)", []).append(t)
+            seen.append(t)
+            sql = r.get("sql")
+            if sql is None or sql == "":
+                declined.append(t)
+            elif not isinstance(sql, str):
+                problems.setdefault("'sql' is not a string (downstream .strip() will raise)",
+                                    []).append(f"{t}={sql!r}")
+        missing = [t for t in asked if t not in seen]
+        if missing:
+            problems["no result returned"] = missing
+        issues = sum(len(v) for v in problems.values())
+        _llm_log(stage, "CHECK", f"{len(set(seen))}/{len(asked)} target(s) answered, "
+                                 f"{len(declined)} declined (sql=null), {issues} issue(s)")
+        for label, items in problems.items():
+            _llm_log(stage, "WARN", f"{label}: {_llm_short(items)}")
+        if issues:
+            _llm_bump(stage, "reply_issues", issues)
+    except Exception as exc:                            # noqa: BLE001
+        _llm_log(stage, "WARN", f"reply check itself failed: {type(exc).__name__}: {exc}")
+
+
+def _llm_check_narrate(parsed: dict, known: list) -> None:
+    """Audit {"mappings": [{target_attribute, rationale}]} for _narrate. Print-only."""
+    stage = "narrate"
+    try:
+        items = parsed.get("mappings", [])
+        if not isinstance(items, list):
+            _llm_bump(stage, "reply_issues")
+            _llm_log(stage, "WARN", f"key 'mappings' is {type(items).__name__}, not a list — "
+                                    f"refinement will be skipped")
+            return
+        known_set = set(known)
+        malformed = [f"#{i}" for i, it in enumerate(items)
+                     if not isinstance(it, dict) or not isinstance(it.get("target_attribute"), str)]
+        unknown = [it["target_attribute"] for it in items
+                   if isinstance(it, dict) and isinstance(it.get("target_attribute"), str)
+                   and it["target_attribute"] not in known_set]
+        returned = {it["target_attribute"] for it in items
+                    if isinstance(it, dict) and isinstance(it.get("target_attribute"), str)}
+        _llm_log(stage, "CHECK", f"{len(returned & known_set)}/{len(known_set)} mapping(s) got a "
+                                 f"rationale, {len(malformed) + len(unknown)} issue(s)")
+        if malformed:
+            _llm_log(stage, "WARN", f"item without a string 'target_attribute' (refinement will be "
+                                    f"skipped): {_llm_short(malformed)}")
+        if unknown:
+            _llm_log(stage, "WARN", f"rationale for unknown target (ignored): {_llm_short(unknown)}")
+        if malformed or unknown:
+            _llm_bump(stage, "reply_issues", len(malformed) + len(unknown))
+    except Exception as exc:                            # noqa: BLE001
+        _llm_log(stage, "WARN", f"reply check itself failed: {type(exc).__name__}: {exc}")
+
+
+def _llm_print_summary() -> None:
+    """One block at the end of map_to_target: did every LLM call work?"""
+    if not _LLM_TRACE_ON:
+        return
+    print("[LLM] ==================== LLM call summary ====================", flush=True)
+    calls = failed = issues = 0
+    for stage, s in _LLM_STATS.items():
+        bad = s["call_failed"] + s["bad_json"] + s["unknown_error"]
+        calls += s["calls"]
+        failed += bad
+        issues += s["reply_issues"]
+        flag = ("SKIP" if s["calls"] == 0 else "FAIL" if bad
+                else "WARN" if s["reply_issues"] else "OK  ")
+        print(f"[LLM] {flag} {stage:<11} calls={s['calls']} json_ok={s['json_ok']} "
+              f"call_failed={s['call_failed']} bad_json={s['bad_json']} "
+              f"unknown_error={s['unknown_error']} reply_issues={s['reply_issues']} "
+              f"offline={s['offline']}", flush=True)
+    if calls == 0:
+        verdict = "NO LLM CALLS WERE MADE — nothing was verified (offline, or no stage needed the model)"
+    elif failed == 0 and issues == 0:
+        verdict = f"ALL {calls} LLM call(s) succeeded and returned usable JSON"
+    else:
+        verdict = (f"{failed} failed call(s) and {issues} unusable reply item(s) across "
+                   f"{calls} LLM call(s) — search the log for [FAIL], [WARN] and [DROP]")
+    print(f"[LLM] {verdict}", flush=True)
+
+
